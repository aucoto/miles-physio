---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path) => `${base}${path}`;
const currentPath = Astro.url.pathname.slice(base.length) || "/";
---
<header class="header"><a class="wordmark" href={url('/')} aria-label="Miles Physio home"><img src={url('/assets/miles-physio-logo.svg?v=2')} alt="Miles Physio" width="111.4" height="60"></a><nav class="desktop-nav" aria-label="Main navigation"><a href={url('/#approach')}>Our approach</a><a href={url('/aposhealth/')} aria-current={currentPath === '/aposhealth/' ? 'page' : undefined}>Apos treatment</a><a href={url('/online-physiotherapy/')} aria-current={currentPath === '/online-physiotherapy/' ? 'page' : undefined}>Online physio</a><a href={url('/about/')} aria-current={currentPath === '/about/' ? 'page' : undefined}>Meet Chris</a></nav><a class="button small header-cta" href="https://miles-physio.uk1.cliniko.com/bookings#service">Let’s talk <span aria-hidden="true"><svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"><span></span><span></span></button><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden><a href={url('/#approach')}>Our approach</a><a href={url('/aposhealth/')} aria-current={currentPath === '/aposhealth/' ? 'page' : undefined}>Apos treatment</a><a href={url('/online-physiotherapy/')} aria-current={currentPath === '/online-physiotherapy/' ? 'page' : undefined}>Online physio</a><a href={url('/about/')} aria-current={currentPath === '/about/' ? 'page' : undefined}>Meet Chris</a><a href={url('/#stories')}>Patient stories</a><a href="https://miles-physio.uk1.cliniko.com/bookings#service">Book a free discovery call <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M6 6h12v12"/></svg></a></nav></header>

